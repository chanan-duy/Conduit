{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**rest}"
        }
      },
      "meetings": {
        "ClusterId": "meetings",
        "Match": {
          "Path": "/api/v1/meetings/{**rest}"
        }
      },
      "meetings-hub": {
        "ClusterId": "meetings",
        "Match": {
          "Path": "/hubs/{**rest}"
        }
      },
      "recordings": {
        "ClusterId": "recording",
        "Match": {
          "Path": "/api/v1/recordings/{**rest}"
        }
      },
      "livekit-webhooks": {
        "ClusterId": "recording",
        "Match": {
          "Path": "/webhooks/livekit",
          "Methods": [
            "POST"
          ]
        }
      },
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/openapi/identity.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "meetings-openapi": {
        "ClusterId": "meetings",
        "Match": {
          "Path": "/openapi/meetings.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "recording-openapi": {
        "ClusterId": "recording",
        "Match": {
          "Path": "/openapi/recording.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "web": {
        "ClusterId": "web",
        "Order": 100,
        "Match": {
          "Path": "{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "meetings": {
        "Destinations": {
          "meetings": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "recording": {
        "Destinations": {
          "recording": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "web": {
        "Destinations": {
          "web": {
            "Address": "http://localhost:5173/"
          }
        }
      }
    }
  }
}
